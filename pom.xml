<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.fleet</groupId>
  <artifactId>fleet-analytics</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>fleet-analytics</name>

  <modules>
    <module>backend</module>
  </modules>

  <properties>
    <!-- starter-parent defaults java.version to 17; M1 targets Java 25. -->
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Local build/codegen database (docker-compose.yml), bound to loopback. -->
    <db.url>jdbc:postgresql://127.0.0.1:5432/fleet</db.url>
    <db.user>fleet</db.user>
    <db.password>fleet</db.password>

    <!-- Pinned image, verified on Docker Hub; used by Compose and the smoke test. -->
    <postgres.image>postgres:18.6-alpine</postgres.image>
  </properties>
</project>
